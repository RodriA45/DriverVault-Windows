<Window x:Class="DriverVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DriverVault.Models"
        Title="DriverVault — Extractor &amp; Organizador de Drivers"
        Width="1160"
        Height="690"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/drivervault.ico"
        Background="{DynamicResource BgPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER SUPERIOR RESPONSIVE -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38"
                        CornerRadius="9"
                        Background="{DynamicResource AccentBg}"
                        Margin="0,0,12,0">
                    <Path Data="M 10 8 L 24 8 L 28 12 L 28 28 L 10 28 Z M 14 8 L 14 15 L 22 15 L 22 8 M 14 21 L 24 21 M 14 25 L 21 25"
                          Stroke="{DynamicResource AccentFg}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Stretch="None" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DriverVault"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Respaldo y organización automática de drivers de Windows"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource BgElevated}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,6"
                        Margin="0,2,8,2">
                    <TextBlock x:Name="TxtSystemInfoPill"
                               Text="Cargando equipo..."
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="11.5" />
                </Border>

                <Border x:Name="AdminBadge"
                        Background="{DynamicResource BadgeBg}"
                        BorderBrush="{DynamicResource BadgeBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,6"
                        Margin="0,2,8,2">
                    <TextBlock x:Name="TxtAdminBadge"
                               Text="Usuario estándar"
                               FontSize="11.5"
                               FontWeight="SemiBold" />
                </Border>

                <Button x:Name="BtnElevateAdmin"
                        Content="Ejecutar como Admin"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnElevateAdmin_Click"
                        Margin="0,2,8,2"
                        ToolTip="Reinicia DriverVault con permisos de Administrador para acceso total" />

                <Button x:Name="BtnToggleTheme"
                        Content="Modo Claro"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnToggleTheme_Click"
                        Margin="0,2,8,2" />

                <Button x:Name="BtnRescan"
                        Content="Re-escanear"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnRescan_Click"
                        Margin="0,2,0,2" />
            </WrapPanel>
        </Grid>

        <!-- BARRA DE AVISO / ESTADO EN TIEMPO REAL -->
        <Border Grid.Row="1" Style="{StaticResource NoticeBanner}" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        Background="{DynamicResource AccentBg}"
                        CornerRadius="4"
                        Padding="7,2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="AVISO"
                               Foreground="{DynamicResource AccentFg}"
                               FontSize="10.5"
                               FontWeight="Bold" />
                </Border>
                <TextBlock x:Name="TxtStatusBanner"
                           Text="Iniciando análisis de controladores instalados..."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12.5" />
            </DockPanel>
        </Border>

        <!-- CUERPO PRINCIPAL (2 COLUMNAS) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="370" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.95*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <!-- PANEL IZQUIERDO: EXPLORADOR DE DRIVERS -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Buscador + Categoría -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="TxtSearch"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="FiltersChanged" />
                            <TextBlock x:Name="TxtSearchPlaceholder"
                                       Text="Buscar por dispositivo, marca, categoría o .inf..."
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <ComboBox x:Name="CmbCategory"
                                  Grid.Column="2"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="FiltersChanged" />
                    </Grid>

                    <!-- Filtros rápidos (Pills) -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <RadioButton x:Name="PillThirdParty"
                                     Content="Solo Terceros (Recomendado)"
                                     Style="{StaticResource FilterPillRadio}"
                                     IsChecked="True"
                                     Checked="FiltersChanged"
                                     Margin="0,0,6,6" />
                        <RadioButton x:Name="PillAllOem"
                                     Content="Todos los OEM"
                                     Style="{StaticResource FilterPillRadio}"
                                     Checked="FiltersChanged"
                                     Margin="0,0,6,6" />
                        <RadioButton x:Name="PillActiveOnly"
                                     Content="Solo en uso"
                                     Style="{StaticResource FilterPillRadio}"
                                     Checked="FiltersChanged"
                                     Margin="0,0,6,6" />
                        <RadioButton x:Name="PillAllWithInbox"
                                     Content="Incluir Windows"
                                     Style="{StaticResource FilterPillRadio}"
                                     Checked="FiltersChanged"
                                     Margin="0,0,6,6" />
                        <RadioButton x:Name="PillUnsigned"
                                     Content="Sin firmar"
                                     Style="{StaticResource FilterPillRadio}"
                                     Checked="FiltersChanged"
                                     Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Deduplicación + Acciones de selección -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkHideDuplicates"
                                  Grid.Column="0"
                                  Content="Ocultar versiones antiguas duplicadas"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="True"
                                  Checked="FiltersChanged"
                                  Unchecked="FiltersChanged"
                                  VerticalAlignment="Center"
                                  Margin="0,2,8,2" />

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Seleccionar visibles"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Click="BtnSelectVisible_Click"
                                    Margin="0,2,6,2" />
                            <Button Content="Ninguno"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Click="BtnDeselectAll_Click"
                                    Margin="0,2,6,2" />
                            <Button Content="Solo activos"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Click="BtnSelectActive_Click"
                                    Margin="0,2,0,2" />
                        </WrapPanel>
                    </Grid>

                    <!-- Barra resumen de lista -->
                    <DockPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtVisibleCount"
                                   DockPanel.Dock="Left"
                                   Text="0 drivers mostrados"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtSelectionSummary"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Text="0 seleccionados · 0 MB"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </DockPanel>

                    <!-- Lista de Drivers -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <ListBox x:Name="ListDrivers"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 SelectionChanged="ListDrivers_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="8,7">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource BgElevated}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DriverEntry}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  Click="DriverCheckBox_Click"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PrimaryDisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Margin="0,0,8,0" />
                                                <Border Background="{DynamicResource BadgeBg}"
                                                        BorderBrush="{DynamicResource BadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OriginBadge}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                                <Border Background="{DynamicResource BadgeBg}"
                                                        BorderBrush="{DynamicResource BadgeBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActivityBadge}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding SubtitleLine}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeFormatted}"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- PANEL DERECHO: GUARDADO, ORGANIZACIÓN Y VISTA PREVIA -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="1. NOMBRE Y UBICACIÓN DEL RESPALDO"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Nombre personalizado de la carpeta:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="TxtBackupName"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="BackupConfigChanged"
                                     Margin="0,0,0,8" />

                            <CheckBox x:Name="ChkDatePrefix"
                                      Content="Agregar fecha automática al nombre (YYYY-MM-DD_...)"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"
                                      Checked="BackupConfigChanged"
                                      Unchecked="BackupConfigChanged"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Dónde guardar el respaldo:"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDestinationRoot"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="BackupConfigChanged" />
                                <Button Grid.Column="2"
                                        Content="Elegir carpeta..."
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnBrowseFolder_Click" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Escritorio"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="9,4"
                                        FontSize="11.5"
                                        Click="BtnDesktopPreset_Click"
                                        Margin="0,0,6,0" />
                                <Button Content="Documentos"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="9,4"
                                        FontSize="11.5"
                                        Click="BtnDocumentsPreset_Click" />
                                <TextBlock x:Name="TxtDiskSpace"
                                           Text=""
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <Border x:Name="PathWarningBox"
                                    Style="{StaticResource NoticeBanner}"
                                    Padding="10,8"
                                    Margin="0,0,0,14">
                                <TextBlock x:Name="TxtPathPreviewNotice"
                                           Text="Se creará la carpeta y sus subcarpetas automáticamente."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="2. ORGANIZACIÓN POR SUBCARPETAS Y EXTRAS"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,8" />

                            <ComboBox x:Name="CmbOrganizationMode"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="BackupConfigChanged"
                                      Margin="0,0,0,10">
                                <ComboBoxItem Content="Categoría / Fabricante (Recomendado)" Tag="CategoryAndManufacturer" IsSelected="True" />
                                <ComboBoxItem Content="Solo por Categoría (Video, Red, Audio...)" Tag="CategoryOnly" />
                                <ComboBoxItem Content="Solo por Fabricante (Intel, NVIDIA, Realtek...)" Tag="ManufacturerOnly" />
                                <ComboBoxItem Content="Carpeta plana (solo 1 subcarpeta por driver)" Tag="Flat" />
                            </ComboBox>

                            <CheckBox x:Name="ChkGenerateBat"
                                      Content="Crear instalador automático (Reinstalar_Drivers.bat)"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"
                                      Checked="BackupConfigChanged"
                                      Unchecked="BackupConfigChanged"
                                      Margin="0,0,0,7" />

                            <CheckBox x:Name="ChkGenerateInventory"
                                      Content="Crear inventario detallado (.html visual y .txt)"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="True"
                                      Checked="BackupConfigChanged"
                                      Unchecked="BackupConfigChanged"
                                      Margin="0,0,0,7" />

                            <CheckBox x:Name="ChkCompressZip"
                                      Content="Comprimir respaldo en un archivo .zip"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="False"
                                      Checked="BackupConfigChanged"
                                      Unchecked="BackupConfigChanged"
                                      Margin="0,0,0,6" />

                            <CheckBox x:Name="ChkKeepZipOnly"
                                      Content="Conservar solo el .zip (borrar carpetas sueltas)"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsEnabled="False"
                                      Margin="22,0,0,14" />

                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="3. VISTA PREVIA DE SUBCARPETAS"
                                           Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtSubfolderPreviewCount"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Text="0 subcarpetas"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}" />
                            </DockPanel>

                            <Border Background="{DynamicResource BgInput}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="6"
                                    Height="195">
                                <TreeView x:Name="TreeFolderPreview"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontFamily="Consolas"
                                          FontSize="11.5">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="True" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type models:FolderPreviewNode}"
                                                                  ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,1.5">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Meta}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Margin="8,0,0,0"
                                                           FontSize="10.5" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="BtnExtract"
                            Grid.Row="1"
                            Content="Extraer Drivers Seleccionados"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnExtract_Click"
                            Margin="0,14,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
